pub fn main() -> i64 {
    let matrix = [
        [1, 2, 3],
        [4, 5, 6]
    ];

    let a = matrix[0][1];
    let b = matrix[1][2];

    matrix[1][0] = 100;

    let repeated = [42; 5];
    let sum = repeated[0] + repeated[1] + repeated[2] + repeated[3] + repeated[4];

    let result = a + b + matrix[1][0] + sum;

    result
}
